# Copy to .env and adjust for your environment. Never commit .env.

# --- Paths ---
DATABASE_PATH=data/processed/analytics.duckdb
RAW_DATA_DIR=data/raw
LOG_DIR=logs

# --- Timezone & currency ---
REPORTING_TIMEZONE=Africa/Addis_Ababa
REPORTING_CURRENCY=ETB
SHOPIFY_SOURCE_CURRENCY=ETB
META_SOURCE_CURRENCY=USD

# FX rate: how many reporting-currency units per 1 unit of source currency.
# 1 USD = 130 ETB. Update manually when the rate moves materially.
USD_TO_REPORTING_FX_RATE=130.0
ETB_TO_REPORTING_FX_RATE=1.0

# --- Business assumptions ---
COGS_PERCENTAGE=0.40
ADMIN_HOURS_PER_WEEK=4.0
ROAS_GREEN_THRESHOLD=3.0
ROAS_AMBER_THRESHOLD=1.5
DQ_REJECTION_THRESHOLD=0.05

# --- Logging ---
LOG_LEVEL=INFO